VITE_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS AuthKit (account sign-in / sign-up). When VITE_WORKOS_CLIENT_ID is
# unset the account UI hides and the app stays freely usable unauthenticated.
# Client ID is public (safe in the bundle); the redirect URI must match one
# registered on your WorkOS application's Redirects tab.
VITE_WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXXXXXXXX
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
