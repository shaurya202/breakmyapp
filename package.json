{
  "name": "breakmyapp",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-human QA, chaos-testing, and security teardown agency — Convex + Exa + Solari + Whop + Terac",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "web:install": "cd web && npm install",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "prospect": "node scripts/exa-prospect.mjs discover",
    "prospect:full": "node scripts/exa-prospect.mjs full",
    "smoke": "convex run audits:listRecent '{\"limit\":10}'",
    "terac:mcp": "node scripts/terac-mcp.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run web:build"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.7",
    "convex": "1.48.0",
    "playwright-core": "^1.64.1",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.65",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
